      "description": "User requests premium report offer.",
      "params": {
        "priceVariant": "4.99|9.99"
      }
    },
    {
      "name": "lead_submitted",
      "description": "User submits advisor lead form.",
      "params": {
        "cityFilled": "0|1",
        "emailFilled": "0|1",
        "consent": "0|1"
      }
    }
