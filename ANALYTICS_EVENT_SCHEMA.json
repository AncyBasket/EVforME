{
  "version": 1,
  "events": [
    {
      "name": "onboarding_completed",
      "description": "User finishes onboarding flow.",
      "params": {}
    },
    {
      "name": "simulation_started",
      "description": "User starts simulation with valid input.",
      "params": {
        "scenario": "String",
        "hasHomeCharging": "0|1",
        "ownershipYears": "String(Int)"
      }
    },
    {
      "name": "verdict_shown",
