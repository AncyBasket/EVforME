                pauseOnFocus: true,
                touch: true,
                slideshow: true,
                after: function (slider) {
                    var $currentSlide = pp_jquery(slider.slides[slider.currentSlide]);
                    var slideTitle = $currentSlide.find('[aria-label]').first().attr('aria-label') || $currentSlide.find('[title]').first().attr('title') || '';
                    var announcement = 'Slide ' + (slider.currentSlide + 1) + ' of ' + slider.count;
