            pp_jquery('.pp_flexslider-8256521').flexslider({
                controlsContainer: ".pp_flexslider-8256521",
                animation: "slide",
                animationLoop: true,
                itemWidth: 150,
                itemMargin: 5,
                slideshowSpeed: 4000,
                pauseOnAction: true,
